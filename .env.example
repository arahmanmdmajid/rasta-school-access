# Copy this file to .env and fill in your own keys. .env is ignored by git.

# --- Runtime (the deployed API needs only this one) ---------------------------
# Free key: https://console.groq.com/keys
# The app still works without it, using the keyword router and computed text.
GROQ_API_KEY=

# --- Build time only (never deployed, never reaches Render) -------------------
# School locations. Free key: https://maps.giga.global/
# Used by scripts/fetch_giga.py to build the district bundles, then never again.
GIGA_SCHOOL_LOCATION_API_KEY=

# --- Optional -----------------------------------------------------------------
# GROQ_MODEL=openai/gpt-oss-120b
# ALLOWED_ORIGINS=http://127.0.0.1:8770,http://localhost:8770
